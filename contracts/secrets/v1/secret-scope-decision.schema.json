{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:node63:secrets:secret-scope-decision:v1",
  "title": "SecretScopeDecisionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "decision",
    "reason_codes",
    "secret_reference_id",
    "scope_id"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_version": { "const": "1.0.0" },
    "decision": {
      "enum": ["MATCH", "MISMATCH", "INDETERMINATE"]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      }
    },
    "secret_reference_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
