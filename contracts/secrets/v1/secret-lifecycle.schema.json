{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:node63:secrets:secret-lifecycle:v1",
  "title": "SecretLifecycleReferenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_status",
    "active_generation",
    "generations",
    "created_at"
  ],
  "properties": {
    "reference_status": {
      "enum": ["active", "revoked", "retired", "legacy"]
    },
    "active_generation": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "null" }
      ]
    },
    "generations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/SecretGenerationReferenceV1" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "last_rotated_at": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "revoked_at": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "retired_at": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "lifecycle_policy_ref": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 512 },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "SecretGenerationReferenceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "state",
        "issued_at"
      ],
      "properties": {
        "generation": { "type": "integer", "minimum": 1 },
        "state": {
          "enum": [
            "candidate",
            "active",
            "overlap",
            "retired",
            "revoked",
            "expired",
            "unavailable",
            "legacy"
          ]
        },
        "issued_at": { "type": "string", "format": "date-time" },
        "activated_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "overlap_until": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "expires_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "retired_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "revoked_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "key_version": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "provider_generation_ref": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 512 },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
