{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:node63:secrets:secret-use-context:v1",
  "title": "SecretUseContextV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "request_id",
    "requesting_principal",
    "resolving_service_principal_id",
    "product_id",
    "environment_id",
    "service_id",
    "tenant_ref",
    "project_ref",
    "resource_ref",
    "provider_ref",
    "purpose",
    "required_privilege_class",
    "authorization_decision_ref"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_version": { "const": "1.0.0" },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "requesting_principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_type", "principal_id"],
      "properties": {
        "principal_type": { "enum": ["human", "service"] },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "resolving_service_principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "product_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "tenant_ref": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tenant_type", "tenant_id"],
          "properties": {
            "tenant_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "tenant_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        },
        { "type": "null" }
      ]
    },
    "project_ref": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_id"],
          "properties": {
            "project_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        },
        { "type": "null" }
      ]
    },
    "resource_ref": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource_type", "resource_id"],
          "properties": {
            "resource_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "resource_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        },
        { "type": "null" }
      ]
    },
    "provider_ref": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider_id"],
          "properties": {
            "provider_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "account_id": {
              "oneOf": [
                { "type": "string", "minLength": 1, "maxLength": 255 },
                { "type": "null" }
              ]
            },
            "target_id": {
              "oneOf": [
                { "type": "string", "minLength": 1, "maxLength": 512 },
                { "type": "null" }
              ]
            },
            "region": {
              "oneOf": [
                { "type": "string", "minLength": 1, "maxLength": 128 },
                { "type": "null" }
              ]
            }
          }
        },
        { "type": "null" }
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "required_privilege_class": {
      "enum": [
        "authenticate",
        "read",
        "write",
        "admin",
        "sign",
        "decrypt",
        "migration",
        "delegation"
      ]
    },
    "target_ref": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 512 },
        { "type": "null" }
      ]
    },
    "authorization_decision_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "approval_ref": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 512 },
        { "type": "null" }
      ]
    }
  }
}
