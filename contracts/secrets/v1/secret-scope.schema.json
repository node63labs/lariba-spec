{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:node63:secrets:secret-scope:v1",
  "title": "SecretScopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_id",
    "environment_id",
    "consumer_bindings",
    "tenant_binding",
    "project_binding",
    "resource_binding",
    "provider_binding",
    "purpose",
    "privilege_class",
    "sharing"
  ],
  "properties": {
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "consumer_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/SecretConsumerBindingV1" }
    },
    "tenant_binding": { "$ref": "#/$defs/SecretTenantBindingV1" },
    "project_binding": { "$ref": "#/$defs/SecretProjectBindingV1" },
    "resource_binding": { "$ref": "#/$defs/SecretResourceBindingV1" },
    "provider_binding": { "$ref": "#/$defs/SecretProviderBindingV1" },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "privilege_class": { "$ref": "#/$defs/SecretPrivilegeClassV1" },
    "sharing": { "$ref": "#/$defs/SecretSharingV1" }
  },
  "$defs": {
    "ProductIdV1": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "SecretPrivilegeClassV1": {
      "enum": [
        "authenticate",
        "read",
        "write",
        "admin",
        "sign",
        "decrypt",
        "migration",
        "delegation"
      ]
    },
    "SecretConsumerBindingV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "environment_id",
        "service_id",
        "service_principal_id",
        "purpose"
      ],
      "properties": {
        "product_id": { "$ref": "#/$defs/ProductIdV1" },
        "environment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "service_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "service_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        }
      }
    },
    "SecretTenantBindingV1": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "tenant_type", "tenant_id"],
          "properties": {
            "mode": { "const": "EXACT" },
            "tenant_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "tenant_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "NOT_APPLICABLE" }
          }
        }
      ]
    },
    "SecretProjectBindingV1": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "project_id"],
          "properties": {
            "mode": { "const": "EXACT" },
            "project_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "NOT_APPLICABLE" }
          }
        }
      ]
    },
    "SecretResourceBindingV1": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "resource_type", "resource_id"],
          "properties": {
            "mode": { "const": "EXACT" },
            "resource_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "resource_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "NOT_APPLICABLE" }
          }
        }
      ]
    },
    "SecretProviderBindingV1": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "provider_id"],
          "properties": {
            "mode": { "const": "EXACT" },
            "provider_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "account_id": {
              "oneOf": [
                { "type": "string", "minLength": 1, "maxLength": 255 },
                { "type": "null" }
              ]
            },
            "target_id": {
              "oneOf": [
                { "type": "string", "minLength": 1, "maxLength": 512 },
                { "type": "null" }
              ]
            },
            "region": {
              "oneOf": [
                { "type": "string", "minLength": 1, "maxLength": 128 },
                { "type": "null" }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "NOT_APPLICABLE" }
          }
        }
      ]
    },
    "SecretSharingV1": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "SINGLE_PRODUCT" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "justification_ref"],
          "properties": {
            "mode": { "const": "EXPLICIT_MULTI_PRODUCT" },
            "justification_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      ]
    }
  }
}
