{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:node63:secrets:secret-reference:v1",
  "title": "SecretReferenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "secret_reference_id",
    "secret_class",
    "owner",
    "scope",
    "lifecycle",
    "storage_class"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_version": { "const": "1.0.0" },
    "secret_reference_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "secret_class": {
      "enum": [
        "api_credential",
        "database_credential",
        "webhook_secret",
        "signing_key",
        "encryption_key_reference",
        "pepper",
        "connection_credential",
        "provider_credential",
        "delivery_credential",
        "acceptance_credential",
        "consumer_api_key",
        "derived_capability_reference"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "owning_service_id"],
      "properties": {
        "product_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "owning_service_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        }
      }
    },
    "scope": {
      "$ref": "./secret-scope.schema.json"
    },
    "lifecycle": {
      "$ref": "./secret-lifecycle.schema.json"
    },
    "storage_class": {
      "enum": [
        "application_encrypted",
        "provider_managed",
        "environment_injected",
        "external_kms_managed",
        "consumer_held",
        "derived_capability"
      ]
    },
    "display_metadata": {
      "oneOf": [
        { "type": "object", "additionalProperties": true },
        { "type": "null" }
      ]
    },
    "evidence_metadata": {
      "oneOf": [
        { "type": "object", "additionalProperties": true },
        { "type": "null" }
      ]
    }
  }
}
