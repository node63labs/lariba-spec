{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:node63:evidence:export-manifest:v1",
  "title": "EvidenceExportManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "export_id",
    "requester_ref",
    "authorization_ref",
    "policy_ref",
    "scopes",
    "record_count",
    "fields_included",
    "fields_redacted",
    "fields_omitted",
    "destination",
    "created_at",
    "artifact_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "export_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "requester_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "policy_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "fields_included": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "fields_redacted": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "fields_omitted": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "destination": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sha256",
            "sha384",
            "sha512"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "expires_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlation_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
