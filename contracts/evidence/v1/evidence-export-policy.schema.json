{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:node63:evidence:export-policy:v1",
  "title": "EvidenceExportPolicyV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "policy_id",
    "policy_version",
    "authority_owner",
    "allowed_record_kinds",
    "allowed_classifications",
    "allowed_fields",
    "prohibited_fields",
    "redaction_profile_ref",
    "destination_classes",
    "purposes",
    "max_scope",
    "domain_ref_resolution_allowed",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "authority_owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "product_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "allowed_record_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "allowed_classifications": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "allowed_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "prohibited_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "redaction_profile_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "destination_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "purposes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "max_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count"
      ],
      "properties": {
        "record_count": {
          "type": "integer",
          "minimum": 1
        },
        "time_window": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "product_scope": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "environment_scope": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "domain_ref_resolution_allowed": {
      "type": "boolean"
    },
    "expiry_policy_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "enum": [
        "DENY",
        "ALLOW_REFERENCE_ONLY",
        "ALLOW_MINIMIZED",
        "ALLOW_RESTRICTED"
      ]
    }
  }
}
