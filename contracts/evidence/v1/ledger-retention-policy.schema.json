{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:node63:evidence:ledger-retention-policy:v1",
  "title": "LedgerRetentionPolicyV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "policy_id",
    "policy_version",
    "authority_owner",
    "applicable_record_kinds",
    "applicable_classifications",
    "retention_rule",
    "supporting_evidence_expiry_allowed",
    "durable_summary_required",
    "disposition_mode"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "authority_owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "product_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "applicable_record_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "applicable_classifications": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "retention_rule": {
      "enum": [
        "NO_AUTOMATIC_EXPIRY",
        "TIME_BOUND",
        "EVENT_BOUND",
        "PRODUCT_POLICY",
        "EXTERNAL_REGULATORY_POLICY"
      ]
    },
    "trigger_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "duration": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "supporting_evidence_expiry_allowed": {
      "type": "boolean"
    },
    "durable_summary_required": {
      "type": "boolean"
    },
    "disposition_mode": {
      "enum": [
        "RETAIN",
        "REDACT",
        "PSEUDONYMIZE",
        "ARCHIVE_RESTRICTED",
        "EXPIRE",
        "DELETE_BY_POLICY"
      ]
    },
    "hold_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
