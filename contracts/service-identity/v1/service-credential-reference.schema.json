{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:node63:lariba-cloud:service-credential-reference:v1",
  "title": "ServiceCredentialReferenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "credential_id", "credential_type", "status"],
  "properties": {
    "schema_version": { "const": 1 },
    "credential_id": { "type": "string", "minLength": 1 },
    "credential_type": { "enum": ["api_key"] },
    "generation": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["active", "expired", "revoked", "replaced"] },
    "expires_at": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    }
  }
}
