{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:node63:observability:trace-sampling-policy:v1",
  "title": "TraceSamplingPolicyV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "policy_id",
    "policy_version",
    "scope",
    "strategy",
    "respect_parent_sampling",
    "always_sample_classes",
    "never_sample_classes",
    "sensitive_trace_policy_ref"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "products",
        "environments"
      ],
      "properties": {
        "products": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "strategy": {
      "enum": [
        "ALWAYS_ON",
        "ALWAYS_OFF",
        "TRACE_ID_RATIO",
        "PARENT_BASED",
        "POLICY_DRIVEN"
      ]
    },
    "rate_or_parameter": {
      "oneOf": [
        {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "respect_parent_sampling": {
      "type": "boolean"
    },
    "always_sample_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "never_sample_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "sensitive_trace_policy_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  }
}
