{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:node63:release:action-binding:v1",
  "title": "ReleaseActionBindingV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "release_record_ref",
    "release_identity",
    "source_commit_sha",
    "environment_ref",
    "target_ref",
    "occurred_at",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "release_record_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "release_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "version",
            "tag",
            "delivery",
            "publication",
            "promotion",
            "other"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "source_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "environment_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "target_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "action_kind": {
      "enum": [
        "deployment",
        "publication",
        "package_publication",
        "contract_promotion"
      ]
    },
    "provider_execution_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "./release-evidence-reference.schema.json"
      }
    }
  }
}
