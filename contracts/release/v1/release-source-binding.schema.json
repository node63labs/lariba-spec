{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:node63:release:source-binding:v1",
  "title": "ReleaseSourceBindingV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "repository",
    "commit_sha",
    "source_ref",
    "binding_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "repository": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+$",
      "maxLength": 255
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_ref_type": {
      "oneOf": [
        {
          "enum": [
            "branch",
            "tag",
            "commit",
            "release-ref",
            "other"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "repository_authority_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "binding_status": {
      "enum": [
        "MATCH",
        "MISMATCH",
        "INDETERMINATE",
        "NOT_APPLICABLE"
      ]
    }
  }
}
