{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:node63:release:build-identity:v1",
  "title": "BuildIdentityV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "build_id",
    "repository",
    "source_commit_sha",
    "ci_execution_ref"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "build_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "builder_identity": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+$",
      "maxLength": 255
    },
    "source_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "ci_execution_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "created_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
