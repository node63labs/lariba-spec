{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:node63:release:evidence-reference:v1",
  "title": "ReleaseEvidenceReferenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "kind",
    "locator"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "digest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "enum": [
                "sha256",
                "sha384",
                "sha512"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
