{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:node63:authentication:session-reference:v1",
  "title": "SessionReferenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "validation_mode",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "validation_mode": {
      "const": "issuer_online"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
