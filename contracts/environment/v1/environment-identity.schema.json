{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:node63:environment:identity:v1",
  "title": "EnvironmentIdentityV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "environment_id",
    "issuing_authority",
    "product_context",
    "environment_class",
    "status",
    "correlation_identity"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_version": { "const": "1.0.0" },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "issuing_authority": {
      "const": "urn:node63:shared-platform:environment-identity"
    },
    "product_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id"],
      "properties": {
        "product_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "organization_context": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["organization_id"],
          "properties": {
            "organization_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        },
        { "type": "null" }
      ]
    },
    "environment_class": {
      "enum": ["development", "test", "preview", "staging", "production"]
    },
    "status": { "enum": ["active", "suspended", "retired"] },
    "correlation_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "metadata": {
      "oneOf": [
        { "type": "object", "additionalProperties": true },
        { "type": "null" }
      ]
    }
  }
}
