{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:node63:environment:release-secret-binding-decision:v1",
  "title": "ReleaseSecretBindingDecisionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "decision",
    "reason_codes",
    "release_binding_id",
    "release_record_id",
    "release_source_sha",
    "secret_reference_id",
    "product_id",
    "environment_id",
    "service_id",
    "service_principal_id",
    "runtime_instance_id",
    "evidence_refs",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_version": { "const": "1.0.0" },
    "decision": { "enum": ["BOUND", "MISMATCH", "INDETERMINATE"] },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      }
    },
    "release_binding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "release_record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "release_source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "secret_reference_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "product_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "service_principal_id": {
      "type": "string",
      "format": "uuid"
    },
    "runtime_instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
